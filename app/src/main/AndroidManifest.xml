<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deliberately NO INTERNET, ACCESS_NETWORK_STATE, QUERY_ALL_PACKAGES,
         READ_SMS, Accessibility, or external storage permissions.
         POST_NOTIFICATIONS (API 33+) is used ONLY to post this app's own
         self-test notification; it is not required to capture LINE/Messenger. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11+).

      The app needs to SEE which messaging packages are installed, so the source
      list can show the correct name and so a real LINE install can be told
      apart from an unrelated package. Without these entries the app can only
      see its own package, and the platform filter would be empty on
      Android 11+.

      This is a <queries> declaration, NOT a permission: it grants visibility
      for the listed packages only and does not let the app read those apps'
      data. QUERY_ALL_PACKAGES is deliberately NOT used.
    -->
    <queries>
        <package android:name="jp.naver.line.android" />
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:label="Private Inbox Classic"
        android:icon="@drawable/ic_classic"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/ClassicTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PrivateNotificationListener"
            android:label="Private Inbox Classic 通知監聽"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
