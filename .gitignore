# Local toolchain / caches that live outside the project tree.
# NOTE: do NOT ignore "gradle/" wholesale — gradle/wrapper/ must stay tracked.
gradle_home/
/gradle/gradle-8.13/
android-sdk/
emulator-home/
.android-home/
*.log

# Agent state (task bookkeeping only, no secrets)
.agent/

# The commit-message scratch files are temporary.
.commit-msg-*.txt

# Python bytecode (embeds absolute __file__ paths)
__pycache__/
*.pyc
